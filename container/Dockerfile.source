# Full image build that compiles diorama inside the build container.
# The everyday loop is container/Dockerfile plus container/dev-image.sh, which
# copies a host incremental binary and skips this compile.

FROM golang:1.27.2-alpine AS containerd
RUN apk add --no-cache make git curl patch
WORKDIR /src
COPY container/wasip3/build-containerd.sh container/wasip3/containerd.patch /build/
RUN sh /build/build-containerd.sh

FROM rust:1.97.1-alpine AS wasip3
RUN apk add --no-cache build-base clang-dev llvm-dev cmake pkgconf \
    libseccomp-dev libseccomp-static protobuf-dev git perl linux-headers curl
WORKDIR /src
COPY container/wasip3/build.sh container/wasip3/runwasi.patch /build/
RUN sh /build/build.sh

FROM rust:1.97.1-bookworm AS build

RUN apt-get update \
    && apt-get install -y --no-install-recommends musl-tools \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /src
COPY . .

ARG TARGETARCH
RUN set -eu; \
    arch=${TARGETARCH:-}; \
    if [ -z "$arch" ]; then \
        case "$(uname -m)" in \
            x86_64) arch=amd64 ;; \
            aarch64|arm64) arch=arm64 ;; \
            *) printf 'unsupported build architecture: %s\n' "$(uname -m)" >&2; exit 1 ;; \
        esac; \
    fi; \
    case "$arch" in \
        amd64) target=x86_64-unknown-linux-musl ;; \
        arm64) target=aarch64-unknown-linux-musl ;; \
        *) printf 'unsupported target architecture: %s\n' "$arch" >&2; exit 1 ;; \
    esac; \
    rustup target add "$target"; \
    cc_var=CC_$(printf '%s' "$target" | tr '-' '_'); \
    export "$cc_var=musl-gcc"; \
    cargo build --locked --profile dist --target "$target" -p diorama -p dioramactl; \
    mkdir -p /out; \
    cp "target/$target/dist/diorama" /out/diorama; \
    cp "target/$target/dist/dioramactl" /out/dioramactl

FROM alpine:3.22

RUN printf '%s\n' \
        "https://dl-cdn.alpinelinux.org/alpine/v3.22/main" \
        "https://dl-cdn.alpinelinux.org/alpine/v3.22/community" \
        > /etc/apk/repositories \
    && apk add --no-cache \
        iptables \
        ip6tables \
        nftables \
        conntrack-tools \
        iproute2 \
        kmod \
        e2fsprogs \
        ca-certificates \
        crun \
        cni-plugins \
    && rm -f /usr/bin/runc /usr/bin/containerd-stress \
    && for bin in /usr/libexec/cni/*; do \
        case "${bin##*/}" in \
            bridge|host-local|portmap|loopback) ;; \
            *) rm -f "$bin" ;; \
        esac; \
    done \
    && mkdir -p /var/lib/diorama /opt/cni/bin \
    && for plugin in bridge host-local portmap loopback; do \
        ln -sfn "/usr/libexec/cni/$plugin" "/opt/cni/bin/$plugin"; \
    done

COPY --from=build --chmod=755 /out/diorama /usr/local/bin/diorama
COPY --from=build --chmod=755 /out/dioramactl /usr/local/bin/dioramactl
COPY --from=wasip3 /out/containerd-shim-wasmtime-v1 /usr/local/bin/containerd-shim-wasmtime-v1
COPY --from=containerd /out/ /usr/local/bin/

COPY --chmod=755 container/entrypoint.sh /usr/local/bin/diorama-entrypoint

VOLUME ["/var/lib/diorama"]

EXPOSE 6443 10250

STOPSIGNAL SIGTERM

ENTRYPOINT ["/usr/local/bin/diorama-entrypoint"]
CMD ["--container-mode"]
