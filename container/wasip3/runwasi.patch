+#[cfg(test)]
+mod tests {
+    use std::path::Path;
+
+    use containerd_shim_wasm::sandbox::context::Source;
+
+    use super::*;
+
+    struct Context {
+        args: Vec<String>,
+        env: Vec<String>,
+    }
+
+    impl RuntimeContext for Context {
+        fn args(&self) -> &[String] {
+            &self.args
+        }
+        fn envs(&self) -> &[String] {
+            &self.env
+        }
+        fn entrypoint(&self) -> Entrypoint<'_> {
+            Entrypoint {
+                source: Source::File(self.args[0].clone().into()),
+                func: "_start".into(),
+                name: None,
+                arg0: Some(Path::new(&self.args[0])),
+            }
+        }
+    }
+
+    #[tokio::test]
+    async fn rejects_core_modules() {
+        let shim = WasmtimeSandbox::default();
+        let ctx = Context {
+            args: vec!["/probe.wasm".into()],
+            env: vec![],
+        };
+        let error = shim
+            .execute(&ctx, b"\0asm\x01\0\0\0", false, "_start".into())
+            .await
+            .unwrap_err();
+        assert!(error.to_string().contains("WASI 0.3"));
+    }
+
+    #[tokio::test]
+    async fn rejects_p2_imports() {
+        let shim = WasmtimeSandbox::default();
+        let component = Component::new(
+            &shim.engine,
+            r#"(component (import "wasi:cli/environment@0.2.0" (instance (export "get-arguments" (func (result (list string)))))))"#,
+        )
+        .unwrap();
+        let ctx = Context {
+            args: vec!["/probe.wasm".into()],
+            env: vec![],
+        };
+        let error = shim
+            .execute_component_async(&ctx, component, "_start".into())
+            .await
+            .unwrap_err();
+        assert!(error.to_string().contains("WASI 0.3 only"));
+    }
+
+    #[tokio::test]
+    #[ignore = "set WASIP3_TEST_COMPONENT to the compiled container/wasip3/probe.rs"]
+    async fn runs_p3_component_and_preserves_exit_status() {
+        let path = std::env::var("WASIP3_TEST_COMPONENT").expect("WASIP3_TEST_COMPONENT");
+        let shim = WasmtimeSandbox::default();
+        let mut ctx = Context {
+            args: vec![path, "hello".into(), "from-test".into()],
+            env: vec!["P3_TEST=from-env".into()],
+        };
+        assert_eq!(shim.run_wasi(&ctx).await.unwrap(), 0);
+        ctx.args[1] = "exit".into();
+        assert_eq!(shim.run_wasi(&ctx).await.unwrap(), 7);
+    }
+}
