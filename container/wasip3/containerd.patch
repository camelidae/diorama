+
+func TestImageStatusRuntimePlatform(t *testing.T) {
+    native := platforms.DefaultSpec()
+    wasm := imagespec.Platform{OS: "wasip3", Architecture: "wasm32"}
+    for _, cached := range []imagespec.Platform{native, wasm} {
+        c, _ := newTestCRIService()
+        c.runtimePlatforms = map[string]*ImagePlatform{"wasmtime": {Platform: &wasm}}
+        image := imagestore.Image{ID: "sha256:d848ce12891bf78792cda4a23c58984033b0c397a55e93a1556202222ecc5ed4", ImageSpec: imagespec.Image{Platform: cached}}
+        var err error
+        c.imageStore, err = imagestore.NewFakeStore([]imagestore.Image{image})
+        require.NoError(t, err)
+        for _, handler := range []string{"", "wasmtime"} {
+            response, err := c.ImageStatus(context.Background(), &runtime.ImageStatusRequest{Image: &runtime.ImageSpec{Image: image.ID, RuntimeHandler: handler}})
+            require.NoError(t, err)
+            assert.Equal(t, (handler == "wasmtime") == (cached.OS == "wasip3"), response.Image != nil)
+        }
+    }
+}
