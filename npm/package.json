{
  "name": "@diorama/cli",
  "version": "0.1.0",
  "description": "Single-node Kubernetes distribution CLI and daemon (diorama and dioramactl)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/geoffsee/diorama.git",
    "directory": "npm"
  },
  "homepage": "https://github.com/geoffsee/diorama#readme",
  "bugs": {
    "url": "https://github.com/geoffsee/diorama/issues"
  },
  "keywords": [
    "diorama",
    "dioramactl",
    "kubernetes",
    "k8s",
    "single-node",
    "cri",
    "oci-cri",
    "edge",
    "containers"
  ],
  "type": "module",
  "module": "./packages/cli/index.ts",
  "main": "./packages/cli/resolve.js",
  "exports": {
    ".": {
      "types": "./packages/cli/index.ts",
      "default": "./packages/cli/resolve.js"
    }
  },
  "bin": {
    "diorama": "./packages/cli/bin/diorama.js",
    "dioramactl": "./packages/cli/bin/dioramactl.js"
  },
  "files": [
    "README.md",
    "packages/cli/bin/",
    "packages/cli/resolve.js",
    "packages/cli/index.ts"
  ],
  "workspaces": [
    "packages/amd64",
    "packages/arm64",
    "packages/aarch64",
    "packages/publisher-cli"
  ],
  "optionalDependencies": {
    "@diorama/amd64": "0.1.0",
    "@diorama/arm64": "0.1.0",
    "@diorama/aarch64": "0.1.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "version:sync": "bun run packages/publisher-cli/index.ts version",
    "build": "bun run packages/publisher-cli/index.ts build",
    "stage": "bun run packages/publisher-cli/index.ts stage",
    "pack:all": "bun run packages/publisher-cli/index.ts pack",
    "publish:all": "bun run packages/publisher-cli/index.ts publish",
    "publish:dry-run": "bun run packages/publisher-cli/index.ts publish --dry-run"
  },
  "devDependencies": {
    "@types/bun": "latest"
  },
  "peerDependencies": {
    "typescript": "^7"
  }
}
